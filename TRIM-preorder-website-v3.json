</main>
<footer><div class="wrap"><span><b style="color:var(--ink)">TRIM</b> · Powered by cawfeeOS</span><span>Founding run · 75 units</span></div></footer>

<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="mt"><div class="modal-card"><h3 id="mt">You're on the list.</h3><p>Your selection is ready for checkout. Connect this step to your payment provider before publishing.</p><div class="summary" id="sum"></div><div class="modal-actions"><button class="btn btn-ghost" type="button" id="copy">Copy summary</button><button class="btn btn-primary" type="button" id="close">Close</button></div></div></div>

<script>
(()=>{
const RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const clamp=(v,a=0,b=1)=>Math.min(b,Math.max(a,v)),seg=(p,a,b)=>clamp((p-a)/(b-a)),ease=t=>1-Math.pow(1-t,3);
const prog=el=>{const r=el.getBoundingClientRect(),h=r.height-innerHeight;return h>0?clamp(-r.top/h):0};
// word reveal
const rv=$('#reveal');rv.innerHTML=rv.innerHTML.replace(/(<span class="hl">75<\/span>)|([^\s<]+)/g,(m,hl,w)=>hl?`<span><span class="hl">75</span></span>`:`<span>${w}</span>`);
const words=[...rv.children];
// units
const U=$('#units');for(let i=0;i<75;i++){const d=document.createElement('i');d.className=i<35?'c1':i<60?'c2':'c3';U.appendChild(d)}const dots=[...U.children];
// brew model: preinfusion 6s, flow ramps 0.3->2.0 g/s; target 36 g; pump cut at cue; drip tail
const TGT=36,DOSE=18;
function shot(t){ // returns weight, flow at time t (s)
 const cut=cueT;if(t<6)return[0,0];
 const w=u=>{u=Math.max(0,u);const T=12;return u<T?.3*u+1.7*u*u/(2*T):.3*T+1.7*T/2+2*(u-T)};
 const f=u=>u<12?.3+1.7*u/12:2;
 if(t<=cut)return[w(t-6),f(t-6)];
 const w0=w(cut-6),f0=f(cut-6),d=t-cut,tau=.75;return[w0+f0*tau*(1-Math.exp(-d/tau)),f0*Math.exp(-d/tau)];
}
let cueT=6;{let t=6;while(t<40){const u=t-6,T=12,w=u<T?.3*u+1.7*u*u/(2*T):.3*T+1.7*T/2+2*(u-T),f=u<12?.3+1.7*u/12:2;if(w+f*.75>=TGT){cueT=t;break}t+=.01}}
const X=t=>30+470*t/30,Y=w=>200-200*w/42;
$('#ltarget').setAttribute('y1',Y(TGT));$('#ltarget').setAttribute('y2',Y(TGT));
const lw=$('#lw'),lt=$('#lt'),lr=$('#lr'),lf=$('#lf'),ls=$('#lstate'),lc=$('#lcurve'),ld=$('#ldot'),lk=$('#lkill'),lkt=$('#lkilltxt'),lsv=$('#lsaved');
const steps=$$('.step'),sd=$$('.step-dots b');
const edImgs=$$('.ed-img'),edItems=$$('.ed-item');
function brew(p){
 const tEnd=cueT+4, t=RM?tEnd:clamp(p/.86)*tEnd;
 let d='',wNow=0,fNow=0;for(let s=0;s<=t+1e-6;s+=.2){const[w]=shot(s);d+=(d?'L':'M')+X(s).toFixed(1)+' '+Y(w).toFixed(1)}
 [wNow,fNow]=shot(t);d+='L'+X(t).toFixed(1)+' '+Y(wNow).toFixed(1);lc.setAttribute('d',d);ld.setAttribute('cx',X(t));ld.setAttribute('cy',Y(wNow));
 const timer=t<6.2?0:t; // timer starts at first drop, backdated display
 const running=t>=6.8;const secs=running?Math.floor(t):0;
 lw.textContent=wNow.toFixed(1)+' g';lt.textContent='00:'+String(Math.min(59,secs)).padStart(2,'0');
 lr.textContent='1:'+(wNow/DOSE).toFixed(1)+' x';lf.textContent=(fNow<.05?0:fNow).toFixed(1)+' g/s';
 // kill line: prototype formula
 let kx=null;if(t>9&&fNow>.15){const rem=(TGT-fNow*1.5-wNow)/fNow;const ts=Math.max(0,rem);if(t+ts<=30)kx=X(t<=cueT?t+ts:cueT)}
 if(kx!==null){lk.setAttribute('x1',kx);lk.setAttribute('x2',kx);lkt.setAttribute('x',kx);lk.style.opacity=1;lkt.style.opacity=1}else{lk.style.opacity=0;lkt.style.opacity=0}
 const phase=p<.2?0:p<.45?1:p<.86?2:3;
 ls.textContent=['Ready','Brewing','Stop cue','Done'][phase];
 steps.forEach((s,i)=>s.classList.toggle('on',i===phase));
 sd.forEach((b,i)=>{const a=[0,.2,.45,.86,1];b.style.transform=`scaleX(${clamp((p-a[i])/(a[i+1]-a[i]))})`});
 lsv.classList.toggle('on',p>.93);$('#lsum').textContent=`${wNow.toFixed(1)} g · ${Math.floor(t)} s · 1:${(wNow/DOSE).toFixed(1)}`;
}
let ticking=false;
function frame(){ticking=false;
 const sh=document.documentElement.scrollHeight-innerHeight;$('#progress').style.width=(100*scrollY/sh)+'%';
 // hero
 const hp=RM?1:prog($('#hero'));
 const ti=$('#heroTitle'),im=$('#heroImg'),cp=$('#heroCopy');
 ti.style.opacity=1-ease(seg(hp,.02,.32));ti.style.transform=`scale(${1+.25*seg(hp,0,.35)})`;
 const z=ease(seg(hp,0,.55)),z2=ease(seg(hp,.4,.7));im.style.transform=`translateY(${-11*z2}vh) scale(${1.35-.35*z-.22*z2})`;im.style.opacity=.22+.78*seg(hp,.05,.4);
 const c=ease(seg(hp,.45,.7));cp.style.opacity=c;cp.style.transform=`translateY(${(1-c)*40}px)`;$('#hint').style.opacity=1-seg(hp,0,.08);
 // words
 const mp=RM?1:prog($('#manifesto'));const n=mp*1.25*words.length;words.forEach((w,i)=>w.style.opacity=i<n?1:.14);
 brew(prog($('#brew')));
 // editions
 const ep=prog($('#editions'));const ei=RM?0:Math.min(2,Math.floor(ep*3));
 edImgs.forEach((e,i)=>e.classList.toggle('on',i===ei));edItems.forEach((e,i)=>e.classList.toggle('on',i===ei));
 // 75
 const sp=RM?1:prog($('#seventyfive'));const k=Math.round(75*ease(seg(sp,.05,.75)));$('#n75').textContent=k;dots.forEach((d,i)=>d.classList.toggle('on',i<k));
}
addEventListener('scroll',()=>{if(!ticking){ticking=true;requestAnimationFrame(frame)}},{passive:true});addEventListener('resize',frame);frame();
// fade-ups
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}}),{threshold:.15});
$$('.fade-up').forEach((el,i)=>{el.style.transitionDelay=(el.classList.contains('tile')?(i%3)*90:0)+'ms';io.observe(el)});
// order form
const P={Cirrus:{f:'White',p:8649,s:35},Carbon:{f:'Black',p:9899,s:25},Canopy:{f:'Clear',p:10899,s:15}};let sel='Cirrus',q=1;
const money=v=>'₹'+new Intl.NumberFormat('en-IN').format(v);const segs=$$('.seg button');
function render(){segs.forEach(b=>b.setAttribute('aria-checked',String(b.dataset.name===sel)));$('#qtyOut').textContent=q;$('#total').textContent=money(P[sel].p*q)}
segs.forEach(b=>b.onclick=()=>{sel=b.dataset.name;q=1;render()});
edItems.forEach((it,i)=>{it.style.cursor='pointer';it.onclick=()=>{sel=['Cirrus','Carbon','Canopy'][i];q=1;render();$('#reserve').scrollIntoView({behavior:RM?'auto':'smooth'})}});
$('#minus').onclick=()=>{q=Math.max(1,q-1);render()};$('#plus').onclick=()=>{q=Math.min(P[sel].s,q+1);render()};
const modal=$('#modal');let last;
$('#orderForm').onsubmit=e=>{e.preventDefault();const nm=$('#name'),em=$('#email'),er=$('#err');if(!nm.value.trim()||!em.value.trim()||!em.validity.valid){er.classList.add('show');(!nm.value.trim()?nm:em).focus();return}er.classList.remove('show');$('#sum').textContent=`${nm.value.trim()} / ${sel} (${P[sel].f}) / Qty ${q} / ${money(P[sel].p*q)} / ${em.value.trim()}`;last=document.activeElement;modal.classList.add('open');$('#close').focus()};
const close=()=>{modal.classList.remove('open');last&&last.focus()};$('#close').onclick=close;modal.onclick=e=>{if(e.target===modal)close()};addEventListener('keydown',e=>{if(e.key==='Escape'&&modal.classList.contains('open'))close()});
$('#copy').onclick=async e=>{const b=e.currentTarget;try{await navigator.clipboard.writeText($('#sum').textContent);b.textContent='Copied'}catch{b.textContent='Select and copy'}setTimeout(()=>b.textContent='Copy summary',1400)};
render();
})();
</script>
</body></html>
