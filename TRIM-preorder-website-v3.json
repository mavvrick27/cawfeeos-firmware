 </div>
 <form class="card fade-up" id="orderForm" novalidate>
  <div class="seg" role="radiogroup" aria-label="Edition">
   <button type="button" role="radio" aria-checked="true" data-name="Cirrus"><b>Cirrus</b><span>White · ₹8,649</span></button>
